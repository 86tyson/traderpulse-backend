# --- Server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins. Production typically:
#   https://traderpulseai.com,https://www.traderpulseai.com,https://admin.traderpulseai.com
FRONTEND_URL=http://localhost:5173
# Optional: regex of additional allowed origins, useful for Vercel preview
# deploys. Example: ^https://fehrertrader-[a-z0-9-]+\.vercel\.app$
# VERCEL_PREVIEW_REGEX=

# Required. Strong random token sent as `Authorization: Bearer <token>` by
# machine clients (curl / scripts / cron / local dev). The DEPLOYED admin
# dashboard does NOT use this — it authenticates via cookie session
# (see ADMIN_DASHBOARD_PASSWORD + SESSION_SECRET below). It must NEVER
# appear in any frontend bundle (no VITE_BACKEND_API_KEY anywhere).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=

# --- Admin dashboard session auth (Required) ---
# ADMIN_DASHBOARD_PASSWORD: the password the admin login form accepts.
# At least 12 characters. Server-side only — NEVER bundled into any frontend.
# Operators type this on https://admin.traderpulseai.com after the edge gate.
ADMIN_DASHBOARD_PASSWORD=
# SESSION_SECRET: HMAC signing key for admin session cookies. Long random hex.
# Rotating it immediately invalidates every issued admin session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Trading mode (defaults are SAFE; do not change without reading README) ---
BOT_ENABLED=false
PAPER_MODE=true
REQUIRE_APPROVAL=true

# --- Risk controls ---
MAX_TRADE_USD=25
MAX_DAILY_LOSS_USD=50
ALLOWED_SYMBOLS=BTC-USD,ETH-USD
MIN_CONFIDENCE=0.5

# --- Robinhood Crypto API (LEAVE BLANK until live mode is ready) ---
# ROBINHOOD_API_KEY: the public API-key string from your Robinhood Crypto API
#   credential registration UI.
# ROBINHOOD_PRIVATE_KEY: the Ed25519 private key (base64 of the 32-byte seed)
#   you generated locally. ONLY the public half should ever leave this machine.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=

# --- Phase 3: micro live testing (defaults are SAFE — read README before changing) ---
# Hard kill switch. While false, NO live order can be placed regardless of any
# other flag. Flipping to `true` requires ROBINHOOD_API_KEY/ROBINHOOD_PRIVATE_KEY
# set, REQUIRE_APPROVAL=true, and ETH-USD as the only allowed live symbol.
LIVE_TRADING_ENABLED=false
LIVE_MAX_ORDER_USD=10
LIVE_DAILY_LOSS_CAP_USD=10
LIVE_ALLOWED_SYMBOLS=ETH-USD
# Hard cap on number of live BUY orders accepted per UTC day. Counts both
# executed and pending_approval rows. Default 5. Increase only after you
# trust assisted-mode behavior across a meaningful sample.
LIVE_DAILY_TRADE_COUNT_CAP=5

# Independent flag for AUTOMATED order placement. Default: false. While false,
# every live order requires manual approval through the dashboard. Setting to
# `true` requires LIVE_TRADING_ENABLED=true and BOT_ENABLED=true (boot will
# refuse otherwise). NOTE: there is currently NO bot execution loop — flipping
# this only affects status / dashboard wording today.
AUTO_TRADING_ENABLED=false

# --- Account assistant (optional) ---
# When set, POST /ai/account-chat uses Anthropic's Claude API to answer
# read-only questions about the user's RH account + local trades. When
# unset, the route returns a deterministic structured summary instead —
# the assistant still works, just less smart. The API key is sent only to
# Anthropic and is NEVER exposed to the frontend or included in any
# AI-context payload.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Storage ---
DATA_DIR=./data
